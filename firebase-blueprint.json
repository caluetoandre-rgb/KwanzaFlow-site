{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial income or expense transaction in Kwanzas",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "category": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "userId", "title", "amount", "type", "date"]
    },
    "KixikilaGroup": {
      "title": "KixikilaGroup",
      "description": "Community savings group (Kixikila) in Angola",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "contributionAmount": { "type": "number" },
        "frequency": { "type": "string" },
        "membersCount": { "type": "number" },
        "creatorId": { "type": "string" }
      },
      "required": ["id", "name", "contributionAmount"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User documents"
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "User financial transactions"
    },
    "/kixikilas/{groupId}": {
      "schema": { "$ref": "#/entities/KixikilaGroup" },
      "description": "Kixikila community groups"
    }
  }
}
